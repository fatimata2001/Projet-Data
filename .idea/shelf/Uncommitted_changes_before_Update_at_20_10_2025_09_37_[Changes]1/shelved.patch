-              <p className="text-xs text-gray-500">Simulation, ratios financiers, comparaison DCA vs Lump Sum</p>
-            </div>
-          </div>
-          <Button variant="outline" size="sm" className="flex items-center gap-1 text-xs"><FileDown className="h-3 w-3"/> Export</Button>
-        </div>
-      </header>
-
-      <main className="max-w-6xl mx-auto px-4 py-6 grid lg:grid-cols-3 gap-6">
-        {/* Paramètres */}
-        <Card className="lg:col-span-1 rounded-2xl shadow-sm">
-          <CardContent className="p-5 space-y-4">
-            <div className="flex items-center gap-2">
-              <Calculator className="h-4 w-4" />
-              <h2 className="font-medium">Paramètres</h2>
-            </div>
-            <div className="space-y-2">
-              <Label>Montant initial (€)</Label>
-              <Input type="number" min={0} value={initial} onChange={(e) => setInitial(Number(e.target.value || 0))} />
-            </div>
-            <div className="grid grid-cols-2 gap-3">
-              <div className="space-y-2">
-                <Label>Contribution récurrente (€)</Label>
-                <Input type="number" min={0} value={recurring} onChange={(e) => setRecurring(Number(e.target.value || 0))} />
-              </div>
-              <div className="space-y-2">
-                <Label>Fréquence</Label>
-                <Select value={freqKey} onValueChange={setFreqKey}>
-                  <SelectTrigger><SelectValue /></SelectTrigger>
-                  <SelectContent>{Object.entries(FREQ).map(([k,v]) => <SelectItem key={k} value={k}>{v.label}</SelectItem>)}</SelectContent>
-                </Select>
-              </div>
-            </div>
-            <div className="space-y-2">
-              <Label>Durée (années): {years}</Label>
-              <Slider value={[years]} min={1} max={40} step={1} onValueChange={(v) => setYears(v[0])} />
-            </div>
-            <div className="grid grid-cols-2 gap-3">
-              <div className="space-y-2">
-                <Label>Frais annuels (%)</Label>
-                <Input type="number" step="0.01" value={(feePct*100).toFixed(2)} onChange={(e)=>setFeePct(Math.max(0,Number(e.target.value)/100))} />
-              </div>
-              <div className="space-y-2">
-                <Label>Actif (ETF)</Label>
-                <Select value={etfId} onValueChange={setEtfId}>
-                  <SelectTrigger><SelectValue /></SelectTrigger>
-                  <SelectContent>{ETF_PRESETS.map(e=><SelectItem key={e.id} value={e.id}>{e.name}</SelectItem>)}</SelectContent>
-                </Select>
-              </div>
-            </div>
-          </CardContent>
-        </Card>
-
-        {/* Dashboard */}
-        <div className="lg:col-span-2 space-y-6">
-          <div className="grid md:grid-cols-5 gap-4">
-            <Card><CardContent className="p-4"><div className="text-xs">Valeur finale</div><div className="text-xl font-semibold">{formatCurrency(finalValue)}</div></CardContent></Card>
-            <Card><CardContent className="p-4"><div className="text-xs">CAGR</div><div className="text-xl font-semibold">{pct(cagr)}</div></CardContent></Card>
-            <Card><CardContent className="p-4"><div className="text-xs">Frais cumulés</div><div className="text-xl font-semibold">{formatCurrency(feePaid)}</div></CardContent></Card>
-            <Card><CardContent className="p-4"><div className="text-xs">Volatilité</div><div className="text-xl font-semibold">{pct(volatility)}</div></CardContent></Card>
-            <Card><CardContent className="p-4"><div className="text-xs flex items-center gap-1"><Sigma className="h-3 w-3"/>Sharpe</div><div className="text-xl font-semibold">{sharpe.toFixed(2)}</div></CardContent></Card>
-          </div>
-
-          <Card className="rounded-2xl"><CardContent className="p-5"><h3 className="font-medium mb-2">Évolution DCA vs Lump Sum</h3><ResponsiveContainer width="100%" height={300}><LineChart><CartesianGrid strokeDasharray="3 3"/><XAxis dataKey="an"/><YAxis/><Tooltip/><Legend/><Line data={points} dataKey="val" name="DCA" stroke="blue" dot={false}/><Line data={lumpSumPoints} dataKey="val" name="Lump Sum" stroke="green" dot={false}/></LineChart></ResponsiveContainer></CardContent></Card>
-
-          <Card className="rounded-2xl"><CardContent className="p-5"><h3 className="font-medium mb-2">Histogramme rendements</h3><ResponsiveContainer width="100%" height={200}><BarChart data={points.map((p,i)=>({an:p.an, rendement:i>0?(p.val-points[i-1].val)/points[i-1].val:0}))}><CartesianGrid strokeDasharray="3 3"/><XAxis dataKey="an"/><YAxis tickFormatter={pct}/><Tooltip formatter={(v)=>pct(v)} /><Bar dataKey="rendement" fill="#8884d8"/></BarChart></ResponsiveContainer></CardContent></Card>
-        </div>
