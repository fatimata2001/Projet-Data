-/**
- * Prototype Étendu : Investissement passif + Data science
- * - Paramètres de simulation
- * - Dashboard métriques (Valeur finale, CAGR, frais, volatilité, Sharpe)
- * - Graphique évolution + histogramme rendements
- * - Comparaison DCA vs Lump Sum
- * - Export rapport (PDF/Excel futur)
- */
-
-const ETF_PRESETS = [
-  { id: "EUNL", name: "ETF World (EUNL)", expectedReturn: 0.07, volatility: 0.15 },
-  { id: "CW8", name: "ETF MSCI World (CW8)", expectedReturn: 0.068, volatility: 0.15 },
-  { id: "PEA-WLD", name: "ETF World PEA", expectedReturn: 0.065, volatility: 0.16 },
-  { id: "EM", name: "ETF Marchés Émergents", expectedReturn: 0.09, volatility: 0.22 },
-  { id: "BONDS", name: "ETF Obligations Monde", expectedReturn: 0.03, volatility: 0.07 },
-];
-
-const FREQ = {
-  monthly: { label: "Mensuelle", periodsPerYear: 12 },
-  quarterly: { label: "Trimestrielle", periodsPerYear: 4 },
-  semiannual: { label: "Semestrielle", periodsPerYear: 2 },
-  annual: { label: "Annuelle", periodsPerYear: 1 },
-};
-
-function formatCurrency(v) {
-  return v.toLocaleString("fr-FR", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
-}
-function pct(v) {
-  return `${(v * 100).toFixed(2)}%`;
-}
-
-export default function PassiveInvestPrototype() {
-  const [initial, setInitial] = useState(10000);
-  const [recurring, setRecurring] = useState(200);
-  const [freqKey, setFreqKey] = useState("monthly");
-  const [years, setYears] = useState(10);
-  const [feePct, setFeePct] = useState(0.002);
-  const [etfId, setEtfId] = useState(ETF_PRESETS[0].id);
-
-  const freq = FREQ[freqKey];
-  const etf = ETF_PRESETS.find((e) => e.id === etfId) ?? ETF_PRESETS[0];
-
-  const riskFreeRate = 0.02; // 2% taux sans risque
-
-  const { points, finalValue, totalContrib, feePaid, cagr, sharpe, volatility, lumpSumPoints } = useMemo(() => {
-    const n = years * freq.periodsPerYear;
-    const r_a = etf.expectedReturn;
-    const r_p = Math.pow(1 + r_a, 1 / freq.periodsPerYear) - 1;
-    const fee_p = Math.pow(1 + feePct, 1 / freq.periodsPerYear) - 1;
-
-    let value = initial;
-    let totalContrib = 0;
-    let feePaid = 0;
-    const pts = [{ idx: 0, an: 0, val: value }];
-    const returns = [];
-
-    for (let i = 1; i <= n; i++) {
-      value += recurring;
-      totalContrib += recurring;
-      const gross = value * (1 + r_p);
-      const f = gross * fee_p;
-      feePaid += f;
-      const newVal = gross - f;
-      returns.push((newVal - value) / value);
-      value = newVal;
-      const an = i / freq.periodsPerYear;
-      pts.push({ idx: i, an, val: value });
-    }
-
-    const finalValue = value;
-    const yearsElapsed = n / freq.periodsPerYear;
-    const cagr = Math.pow(finalValue / Math.max(1, initial + totalContrib), 1 / Math.max(1, yearsElapsed)) - 1;
-    const avgReturn = returns.reduce((a, b) => a + b, 0) / returns.length;
-    const variance = returns.reduce((acc, r) => acc + Math.pow(r - avgReturn, 2), 0) / returns.length;
-    const volatility = Math.sqrt(variance) * Math.sqrt(freq.periodsPerYear);
-    const sharpe = volatility > 0 ? (avgReturn * freq.periodsPerYear - riskFreeRate) / volatility : 0;
-
-    // Lump Sum comparaison (investissement tout au début)
-    let lumpVal = initial + totalContrib;
-    const lumpPts = [{ an: 0, val: lumpVal }];
-    for (let i = 1; i <= years; i++) {
-      lumpVal *= 1 + r_a;
-      lumpPts.push({ an: i, val: lumpVal });
-    }
-
-    return { points: pts, finalValue, totalContrib, feePaid, cagr, sharpe, volatility, lumpSumPoints: lumpPts };
-  }, [initial, recurring, freq.periodsPerYear, years, feePct, etf.expectedReturn]);
-
-  const invested = initial + totalContrib;
-
-  return (
